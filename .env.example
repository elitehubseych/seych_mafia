# Токен сообщества ВК (раздел: Управление > Работа с API > Ключи доступа)
# Включи право «Отправка сообщений» (права доступа: messages)
VK_TOKEN=

# Строка подтверждения из настроек Callback API сообщества (Управление > Сообщения > Callback API)
VK_CONFIRMATION=

# Секретный ключ Callback API (опционально, но рекомендуется)
VK_SECRET=

# ID сообщества (число)
VK_GROUP_ID=

# Порт/хост сервера Callback API
# (на Render порт задаётся переменной PORT автоматически — можно не указывать)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Путь для входящих событий (произвольный, лучше сложный)
CALLBACK_PATH=/

# Интервал keep-alive пинга в секундах (Render берёт URL из переменной RENDER_EXTERNAL_URL сам)
KEEPALIVE_INTERVAL=600

# --- Мини-апп «Мафия» (VK Mini Apps) ---
# ID приложения (https://vk.com/appXXXXXXX — настройки приложения)
VK_APP_ID=
# Защищённый ключ приложения (Настройки > Доступ)
VK_APP_SECRET=
# Базовый URL, где крутится этот сервер (например https://seych-ai.onrender.com)
# Нужен для ссылки на фронтенд, если VK_APP_ID не задан, и для CORS.
APP_BASE_URL=
# Разрешённые Origin для мини-аппа через запятую (если фронтенд размещён отдельно)
APP_CORS_ORIGINS=
# Разрешить вход без подписи launch-params (отладка в браузере). В проде выключить: false
APP_ALLOW_UNSIGNED=true

# URL для подключения к Postgres, например postgres://user:pass@host:port/dbname
DATABASE_URL=

# Если используете Supabase, значения можно хранить в Render как переменные окружения,
# но для этой версии бота нужен только DATABASE_URL для прямого подключения к Postgres.
SUPABASE_URL=
SUPABASE_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
