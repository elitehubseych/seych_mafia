# Токен сообщества ВК (раздел: Управление > Работа с API > Ключи доступа)
# Включи право «Отправка сообщений» (права доступа: messages)
VK_TOKEN=

# Строка подтверждения из настроек Callback API сообщества (Управление > Сообщения > Callback API)
VK_CONFIRMATION=

# Секретный ключ Callback API (опционально, но рекомендуется)
VK_SECRET=

# ID сообщества (число)
VK_GROUP_ID=

# Порт/хост сервера Callback API
# (на Render порт задаётся переменной PORT автоматически — можно не указывать)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Путь для входящих событий (произвольный, лучше сложный)
CALLBACK_PATH=/

# Интервал keep-alive пинга в секундах (Render берёт URL из переменной RENDER_EXTERNAL_URL сам)
KEEPALIVE_INTERVAL=600
